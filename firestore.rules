rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.admin == true
          || (exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
            && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin'));
    }

    function canWriteArticles() {
      return isAdmin()
        || (request.auth != null
          && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
          && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'editor');
    }

    function validClubInformation(data) {
      return data.keys().hasAll([
          'email', 'postalAddress', 'city', 'department',
          'facebookUrl', 'instagramUrl', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'email', 'postalAddress', 'city', 'department',
          'facebookUrl', 'instagramUrl', 'updatedAt'
        ])
        && data.email is string
        && data.email.size() > 2
        && data.email.size() <= 254
        && data.email.matches('^[^ ]+@[^ ]+\\.[^ ]+$')
        && data.postalAddress is string
        && data.postalAddress.size() > 0
        && data.postalAddress.size() <= 200
        && data.city is string
        && data.city.size() > 0
        && data.city.size() <= 100
        && data.department is string
        && data.department.size() > 0
        && data.department.size() <= 100
        && data.facebookUrl is string
        && data.facebookUrl.size() <= 2000
        && (data.facebookUrl == '' || data.facebookUrl.matches('^https://[^ ]+$'))
        && data.instagramUrl is string
        && data.instagramUrl.size() <= 2000
        && (data.instagramUrl == '' || data.instagramUrl.matches('^https://[^ ]+$'))
        && data.updatedAt is timestamp;
    }

    function validHomePageContent(data) {
      return data.keys().hasAll([
          'heroImages', 'heroEyebrow', 'heroTitleAccent', 'heroTitle',
          'heroPitch', 'heroLine', 'heroSlogan', 'introEyebrow', 'introText',
          'storyEyebrow', 'storyTitle', 'storyAccent', 'storyParagraph1',
          'storyParagraph2', 'storyImage', 'storyImageAlt', 'storyCaption',
          'valuesEyebrow', 'valuesTitle', 'valuesAccent', 'value1Title',
          'value1Description', 'value2Title', 'value2Description',
          'value3Title', 'value3Description', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'heroImages', 'heroEyebrow', 'heroTitleAccent', 'heroTitle',
          'heroPitch', 'heroLine', 'heroSlogan', 'introEyebrow', 'introText',
          'storyEyebrow', 'storyTitle', 'storyAccent', 'storyParagraph1',
          'storyParagraph2', 'storyImage', 'storyImageAlt', 'storyCaption',
          'valuesEyebrow', 'valuesTitle', 'valuesAccent', 'value1Title',
          'value1Description', 'value2Title', 'value2Description',
          'value3Title', 'value3Description', 'updatedAt'
        ])
        && data.heroImages is list
        && data.heroImages.size() == 3
        && data.heroImages[0] is string
        && data.heroImages[0].size() <= 2000
        && data.heroImages[0].matches('^https://[^ ]+$')
        && data.heroImages[1] is string
        && data.heroImages[1].size() <= 2000
        && data.heroImages[1].matches('^https://[^ ]+$')
        && data.heroImages[2] is string
        && data.heroImages[2].size() <= 2000
        && data.heroImages[2].matches('^https://[^ ]+$')
        && data.heroEyebrow is string && data.heroEyebrow.size() <= 120
        && data.heroTitleAccent is string && data.heroTitleAccent.size() <= 80
        && data.heroTitle is string && data.heroTitle.size() <= 100
        && data.heroPitch is string && data.heroPitch.size() <= 200
        && data.heroLine is string && data.heroLine.size() <= 200
        && data.heroSlogan is string && data.heroSlogan.size() <= 200
        && data.introEyebrow is string && data.introEyebrow.size() <= 100
        && data.introText is string && data.introText.size() <= 1000
        && data.storyEyebrow is string && data.storyEyebrow.size() <= 100
        && data.storyTitle is string && data.storyTitle.size() <= 100
        && data.storyAccent is string && data.storyAccent.size() <= 100
        && data.storyParagraph1 is string && data.storyParagraph1.size() <= 1500
        && data.storyParagraph2 is string && data.storyParagraph2.size() <= 1500
        && data.storyImage is string
        && data.storyImage.size() <= 2000
        && data.storyImage.matches('^https://[^ ]+$')
        && data.storyImageAlt is string && data.storyImageAlt.size() <= 250
        && data.storyCaption is string && data.storyCaption.size() <= 120
        && data.valuesEyebrow is string && data.valuesEyebrow.size() <= 100
        && data.valuesTitle is string && data.valuesTitle.size() <= 100
        && data.valuesAccent is string && data.valuesAccent.size() <= 100
        && data.value1Title is string && data.value1Title.size() <= 80
        && data.value1Description is string && data.value1Description.size() <= 300
        && data.value2Title is string && data.value2Title.size() <= 80
        && data.value2Description is string && data.value2Description.size() <= 300
        && data.value3Title is string && data.value3Title.size() <= 80
        && data.value3Description is string && data.value3Description.size() <= 300
        && data.updatedAt is timestamp;
    }

    match /userRoles/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role in ['admin', 'editor']
        && (request.auth.uid != userId || request.auth.token.admin != true || request.resource.data.role == 'admin');
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /articles/{articleId} {
      allow read: if true;
      allow create, update: if canWriteArticles();
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if canWriteArticles()
        && request.resource.data.keys().hasAll(['title', 'date', 'detail', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['title', 'date', 'detail', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.detail is string
        && request.resource.data.detail.size() > 0
        && request.resource.data.detail.size() <= 500
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /siteContent/{contentId} {
      allow read: if contentId in [
        'horaires', 'schedule', 'clubInformation', 'homePage'
      ];
      allow create, update: if (
          contentId in ['horaires', 'schedule']
          && canWriteArticles()
        && request.resource.data.keys().hasAll([
          'adultVenue', 'adultAddress', 'adultSlots',
          'youthVenue', 'youthAddress', 'youthNote', 'youthSlots',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'adultVenue', 'adultAddress', 'adultSlots',
          'youthVenue', 'youthAddress', 'youthNote', 'youthSlots',
          'updatedAt'
        ])
        && request.resource.data.adultVenue is string
        && request.resource.data.adultVenue.size() > 0
        && request.resource.data.adultVenue.size() <= 120
        && request.resource.data.adultAddress is string
        && request.resource.data.adultAddress.size() > 0
        && request.resource.data.adultAddress.size() <= 200
        && request.resource.data.adultSlots is list
        && request.resource.data.adultSlots.size() <= 30
        && request.resource.data.youthVenue is string
        && request.resource.data.youthVenue.size() > 0
        && request.resource.data.youthVenue.size() <= 120
        && request.resource.data.youthAddress is string
        && request.resource.data.youthAddress.size() > 0
        && request.resource.data.youthAddress.size() <= 200
        && request.resource.data.youthNote is string
        && request.resource.data.youthNote.size() <= 300
        && request.resource.data.youthSlots is list
        && request.resource.data.youthSlots.size() <= 30
        && request.resource.data.updatedAt is timestamp
        ) || (
          contentId == 'clubInformation'
          && isAdmin()
          && validClubInformation(request.resource.data)
        ) || (
          contentId == 'homePage'
          && isAdmin()
          && validHomePageContent(request.resource.data)
        );
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && teamId.matches('^[0-9]+$')
        && request.resource.data.keys().hasAll(['name', 'shortName', 'players', 'matches', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'shortName', 'players', 'matches', 'standings', 'sourceUrl', 'season', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.shortName is string
        && request.resource.data.shortName.size() > 0
        && request.resource.data.shortName.size() <= 60
        && request.resource.data.players is list
        && request.resource.data.players.size() <= 60
        && request.resource.data.matches is list
        && request.resource.data.matches.size() <= 80
        && request.resource.data.standings is list
        && request.resource.data.standings.size() <= 40
        && request.resource.data.sourceUrl is string
        && request.resource.data.sourceUrl.matches('^https://icbad\\.ffbad\\.org/equipe/[0-9]+$')
        && request.resource.data.season is string
        && request.resource.data.season.size() <= 20
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /boardMembers/{memberId} {
      allow read: if true;
      allow create, update: if canWriteArticles()
        && request.resource.data.keys().hasAll(['name', 'role', 'photoUrl', 'updatedAt', 'order'])
        && request.resource.data.keys().hasOnly(['name', 'role', 'photoUrl', 'updatedAt', 'order'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.role is string
        && request.resource.data.role.size() > 0
        && request.resource.data.role.size() <= 100
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2000
        && (request.resource.data.photoUrl == ''
          || request.resource.data.photoUrl.matches('^https://res\\.cloudinary\\.com/[^/]+/image/upload/.+$'))
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.updatedAt is timestamp;
      allow delete: if canWriteArticles();
    }

  }
}